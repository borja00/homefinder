{
  "name": "homefinder",
  "version": "0.2.0",
  "description": "Track Idealista listings: price history, trends and comparison",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "homefinder": "src/cli.js"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch-path=src --watch-path=db src/cli.js serve",
    "build": "vite build",
    "start": "node src/cli.js serve",
    "scrape": "node src/cli.js scrape",
    "migrate": "node src/cli.js migrate",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^5.3.0",
    "node-html-parser": "^9.0.7",
    "postgres": "^4.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "chart.js": "^4.6.1",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8"
  }
}
